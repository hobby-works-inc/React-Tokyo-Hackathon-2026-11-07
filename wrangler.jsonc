{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "genui-nudge-ec",
  "compatibility_date": "2025-11-17",
  "compatibility_flags": ["nodejs_als"],
  // ここに書いた vars は scripts/cf-postbuild.mjs がデプロイ用設定 (dist/server/wrangler.json) にコピーする。
  // OPENCODE_API_KEY / DEMO_ACCESS_TOKEN はここに書かず `npx wrangler secret put` で登録する。
  "vars": {
    "LLM_MODE": "live",
    "OPENCODE_BASE_URL": "https://opencode.ai/inference",
    "OPENCODE_MODEL": "claude-sonnet-5-5",
    "OPENCODE_API_FORMAT": "auto",
    "OPENCODE_THINKING": "off",
    "LLM_TIMEOUT_MS": "30000",
    "LLM_MAX_REQUESTS_PER_MINUTE": "20"
  }
}
