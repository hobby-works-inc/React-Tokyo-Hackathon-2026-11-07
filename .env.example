# ---- 生成UI誘導ECデモ 環境変数 ----
# ローカル: このファイルを .env.local にコピーして値をセット（.env.local はコミットしない）
# Cloudflare: シークレットは `npx wrangler secret put <NAME>`、それ以外は wrangler.jsonc の vars

# [secret] OpenCode Console の API キー（oc_sk_...）。live モードで必須
OPENCODE_API_KEY=

# [secret, 任意] 公開URLを無制限のLLMプロキシにしないための合言葉。
# セットすると、live モードの LLM 呼び出しに画面で入力した合言葉が必要になる
DEMO_ACCESS_TOKEN=

# mock | live（未設定時 mock）
LLM_MODE=mock

# OpenCode Inference API のベースURL
OPENCODE_BASE_URL=https://opencode.ai/inference

# 使用モデル（https://opencode.ai/inference/v1/models で一覧）
OPENCODE_MODEL=claude-sonnet-5-5

# auto | anthropic | openai-chat
# auto: claude-* / qwen* は Anthropic Messages API、それ以外は OpenAI Chat Completions
OPENCODE_API_FORMAT=auto

# LLM 1回の呼び出しタイムアウト（ミリ秒）
LLM_TIMEOUT_MS=30000

# セッションごとの1分あたり LLM 呼び出し上限（isolate 単位のベストエフォート）
LLM_MAX_REQUESTS_PER_MINUTE=20

# ---- Cloudflare デプロイ用（wrangler 標準の変数名。アプリ本体では使わない） ----
# CI やローカルから `npm run deploy` するときにシェル環境変数としてセットする（.env には書かない）
# CLOUDFLARE_API_TOKEN=   # Workers を編集できる API トークン
# CLOUDFLARE_ACCOUNT_ID=  # Cloudflare のアカウントID
